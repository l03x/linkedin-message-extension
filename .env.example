# Copy to .env and fill in:  cp .env.example .env

# Shared secret for the extension (Bearer token) and the dashboard login. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me

# Host port for the API + dashboard (bound to 127.0.0.1 only).
PORT=8765

# OpenAI-compatible LLM API (e.g. claude-headless-api). Include the /v1 suffix.
# An API running on this machine (outside Docker) is reachable as host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=chk_your_token_here
LLM_MODEL=sonnet
# claude-headless-api only: low | medium | high | xhigh | max. Leave empty for other providers.
# This is the starting value: once you pick an effort on the dashboard's Prompts page, that one is used.
LLM_EFFORT=low
# Claude headless runs can take a while.
LLM_TIMEOUT_SECONDS=180

# Days a company's web research stays fresh before it is searched again (default 30). The dashboard's
# Companies page can override it. Research you edited by hand never expires.
RESEARCH_TTL_DAYS=30

# OCR languages for scanned CVs on "My context" ("+"-separated Tesseract codes: eng, fra, ara).
# Add ara only if your CV is in Arabic: every extra language slows OCR down.
OCR_LANGS=eng+fra

# Used to bucket the stats by day/week and to show times in the dashboard.
TIMEZONE=Africa/Casablanca

# SQLite file on the named volume. No need to change.
DATABASE_URL=sqlite:////data/app.db
